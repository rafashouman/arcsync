[Unit]
Description=ArcSync encrypted backup (configure before enabling)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/arcsync/current
EnvironmentFile=/etc/arcsync/backup.env
ExecStart=/usr/bin/bash /opt/arcsync/current/ops/backup.sh
UMask=0077
TimeoutStartSec=30min
